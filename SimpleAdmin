-- ─────────────────────────────────────────────────────────────── theme
local DEFAULTS = {
	Accent = Color3.fromRGB(107, 139, 255),
	Panel = Color3.fromRGB(20, 24, 33),
	Row = Color3.fromRGB(32, 38, 52),
	Stroke = Color3.fromRGB(255, 255, 255),
	Text = Color3.fromRGB(232, 238, 250),
	Dim = Color3.fromRGB(132, 144, 168),
	PanelTransparency = 0.06,
	RowTransparency = 0.55,
	Corner = 8,
	Scale = 1,
}

local Theme = {}
for k, v in pairs(DEFAULTS) do
	Theme[k] = v
end

local themeRegistry = {}
local switchRedraw = {}
local uiScale = nil

local function applyKind(obj, kind)
	if kind == "window" then
		obj.BackgroundColor3 = Theme.Panel
		obj.BackgroundTransparency = Theme.PanelTransparency
	elseif kind == "row" then
		obj.BackgroundColor3 = Theme.Row
		obj.BackgroundTransparency = Theme.RowTransparency
	elseif kind == "button" then
		obj.BackgroundColor3 = Theme.Row
		obj.BackgroundTransparency = math.clamp(Theme.RowTransparency + 0.25, 0, 0.98)
	elseif kind == "text" then
		obj.TextColor3 = Theme.Text
	elseif kind == "dim" then
		obj.TextColor3 = Theme.Dim
	elseif kind == "accent" then
		obj.TextColor3 = Theme.Accent
	elseif kind == "accentFill" then
		obj.BackgroundColor3 = Theme.Accent
		obj.BackgroundTransparency = 0
	elseif kind == "accentSoft" then
		obj.BackgroundColor3 = Theme.Accent
		obj.BackgroundTransparency = 0.72
	elseif kind == "track" then
		obj.BackgroundColor3 = Theme.Text
		obj.BackgroundTransparency = 0.86
	elseif kind == "scroll" then
		obj.ScrollBarImageColor3 = Theme.Accent
	end
end

local function applyTheme()
	for _, entry in ipairs(themeRegistry) do
		pcall(applyKind, entry.obj, entry.kind)

		local cornerInst = entry.obj:FindFirstChildOfClass("UICorner")
		if cornerInst then
			cornerInst.CornerRadius = UDim.new(0, Theme.Corner)
		end

		local strokeInst = entry.obj:FindFirstChildOfClass("UIStroke")
		if strokeInst then
			strokeInst.Color = Theme.Stroke
			strokeInst.Transparency = 0.82
		end
	end

	for _, redraw in ipairs(switchRedraw) do
		pcall(redraw)
	end

	if uiScale then
		uiScale.Scale = Theme.Scale
	end

	if refreshTabHighlight then
		refreshTabHighlight()
	end
end

-- ─────────────────────────────────────────────────────────────── helpers
local function reg(obj, kind)
	themeRegistry[#themeRegistry + 1] = { obj = obj, kind = kind }
	if kind then
		applyKind(obj, kind)
	end
	return obj
end

local function corner(obj, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r or Theme.Corner)
	c.Parent = obj
	return c
end

local function stroke(obj, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.82
	s.Color = Theme.Stroke
	s.Parent = obj
	return s
end

local function new(class, props, parent)
	local obj = Instance.new(class)
	for key, value in pairs(props) do
		obj[key] = value
	end
	obj.Parent = parent
	return obj
end

local function round(x)
	return math.floor(x + 0.5)
end

