section(pageConfig, "THEME DATA")

local THEME_FILE = "SimpleAdminTheme.json"

local function serializeTheme()
	local data = {}
	for key, value in pairs(Theme) do
		if typeof(value) == "Color3" then
			local r, g, b = channelOf(value)
			data[key] = { r, g, b }
		else
			data[key] = value
		end
	end
	return HttpService:JSONEncode(data)
end

local function deserializeTheme(encoded)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(encoded)
	end)
	if not ok or type(data) ~= "table" then
		return false
	end
	for key, value in pairs(data) do
		if DEFAULTS[key] ~= nil then
			if type(value) == "table" and #value == 3 then
				Theme[key] = Color3.fromRGB(value[1], value[2], value[3])
			elseif type(value) == type(DEFAULTS[key]) then
				Theme[key] = value
			end
		end
	end
	return true
end

makeButton(pageConfig, "Save Theme", function()
	local encoded = serializeTheme()
	shared.SimpleAdminTheme = encoded
	if writefile then
		pcall(writefile, THEME_FILE, encoded)
	end
end)

makeButton(pageConfig, "Load Theme", function()
	local encoded = nil
	if isfile and isfile(THEME_FILE) then
		local ok, content = pcall(readfile, THEME_FILE)
		if ok then
			encoded = content
		end
	end
	if not encoded and type(shared.SimpleAdminTheme) == "string" then
		encoded = shared.SimpleAdminTheme
	end
	if not encoded or not deserializeTheme(encoded) then
		return
	end
	local ar, ag, ab = channelOf(Theme.Accent)
	accentR.set(ar)
	accentG.set(ag)
	accentB.set(ab)
	local br, bg, bb = channelOf(Theme.Panel)
	bgR.set(br)
	bgG.set(bg)
	bgB.set(bb)
	applyTheme()
end)

makeButton(pageConfig, "Copy Theme String", function()
