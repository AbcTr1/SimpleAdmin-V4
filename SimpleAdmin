local function makeSlider(parent, text, minValue, maxValue, initial, step, onChange)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 26),
		BackgroundTransparency = 1,
	}, parent)

	local label = new("TextLabel", {
		Size = UDim2.new(1, -46, 0, 12),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = text,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Dim,
	}, row)
	reg(label, "dim")

	local valueLabel = new("TextLabel", {
		Size = UDim2.fromOffset(46, 12),
		Position = UDim2.new(1, -46, 0, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.Code,
		Text = tostring(initial),
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Theme.Accent,
	}, row)
	reg(valueLabel, "accent")

	local bar = new("Frame", {
		Size = UDim2.new(1, 0, 0, 4),
		Position = UDim2.new(0, 0, 1, -8),
		BackgroundColor3 = Theme.Text,
		BackgroundTransparency = 0.86,
		BorderSizePixel = 0,
	}, row)
	corner(bar, 2)
	reg(bar, "track")

	local fill = new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
	}, bar)
	corner(fill, 2)
	reg(fill, "accentFill")

	local knob = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(9, 9),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Theme.Accent,
		BorderSizePixel = 0,
		ZIndex = 3,
	}, bar)
	corner(knob, 999)
	reg(knob, "accentFill")

	local value = initial

	local function render()
		local alpha = (maxValue > minValue) and ((value - minValue) / (maxValue - minValue)) or 0
		fill.Size = UDim2.fromScale(alpha, 1)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		if step >= 1 then
			valueLabel.Text = tostring(round(value))
		else
			valueLabel.Text = string.format("%.2f", value)
		end
	end

	local dragging = false

	local function setFromX(absX)
		local width = math.max(bar.AbsoluteSize.X, 1)
		local alpha = math.clamp((absX - bar.AbsolutePosition.X) / width, 0, 1)
		local raw = minValue + alpha * (maxValue - minValue)
		if step >= 1 then
			raw = round(raw / step) * step
		end
		value = math.clamp(raw, minValue, maxValue)
		render()
		if onChange then
			onChange(value)
		end
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			setFromX(input.Position.X)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	render()

	return {
		get = function()
			return value
		end,
		set = function(nextValue)
			value = math.clamp(nextValue, minValue, maxValue)
			render()
		end,
	}
end

local function makeToggle(parent, text, initial, onChange)
	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, 24),
		BackgroundTransparency = 1,
	}, parent)

	local label = new("TextLabel", {
		Size = UDim2.new(1, -42, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = text,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Theme.Text,
	}, row)
	reg(label, "text")

	local track = new("Frame", {
		Size = UDim2.fromOffset(26, 13),
		Position = UDim2.new(1, -26, 0.5, -6.5),
		BackgroundColor3 = Theme.Row,
		BorderSizePixel = 0,
	}, row)
	corner(track, 999)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(9, 9),
		Position = UDim2.new(0, 2, 0.5, -4.5),
		BackgroundColor3 = Theme.Dim,
		BorderSizePixel = 0,
	}, track)
	corner(knob, 999)

	local hit = new("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 4,
	}, row)

	local state = initial

	local function redraw()
		if state then
			track.BackgroundColor3 = Theme.Accent
			track.BackgroundTransparency = 0
			knob.Position = UDim2.new(1, -11, 0.5, -4.5)
			knob.BackgroundColor3 = Color3.new(1, 1, 1)
			label.TextColor3 = Theme.Text
		else
			track.BackgroundColor3 = Theme.Row
			track.BackgroundTransparency = math.clamp(Theme.RowTransparency - 0.1, 0, 1)
			knob.Position = UDim2.new(0, 2, 0.5, -4.5)
			knob.BackgroundColor3 = Theme.Dim
			label.TextColor3 = Theme.Dim
		end
	end

	switchRedraw[#switchRedraw + 1] = redraw
	redraw()

	hit.MouseButton1Click:Connect(function()
		state = not state
		redraw()
		if onChange then
			onChange(state)
		end
	end)

	return {
		get = function()
			return state
		end,
		set = function(nextState)
			state = nextState
			redraw()
		end,
	}
end

